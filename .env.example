# Copy this file to ".env" and paste your free Gemini API key below.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional overrides (defaults are fine for the prototype)
# gemini-3.5-flash-lite has a generous free-tier quota (~500 requests/day),
# which comfortably covers testing + the H01-H06 batch + a live demo.
# The full Flash models (e.g. gemini-3.8-flash) are smarter but only allow
# ~20 free requests/day, which is easy to exhaust during a hackathon.
GEMINI_MODEL=gemini-3.5-flash-lite
